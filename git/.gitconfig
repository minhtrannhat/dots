[pull]
	rebase = false
[user]
	email = minhtrannhat@tutanota.com
	name = minhtrannhat
	signingkey = 894C6A5801E01CA9
[commit]
	gpgsign = true
[init]
	defaultBranch = master
[gpg]
	program = /usr/bin/gpg
[pager]
    diff = delta
    log = delta
    reflog = delta
    show = delta

[delta]
    side-by-side = true
    line-numbers = true
    syntax-theme = gruvbox-dark
    navigate = true

[interactive]
    diffFilter = delta --color-only --diff-so-fancy --show-config

[github]
	user = minhtrannhat

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
